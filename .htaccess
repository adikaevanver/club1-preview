# =====================================================================
# club1.moscow — конфигурация хостинга reg.ru (Apache)
#
# Сайт открыт 28.08.2026: блок «ЗАКРЫТЫЙ ДОСТУП» (basic-auth + X-Robots-Tag
# noindex) снят. Закрыть обратно — вернуть блок из истории гита (до #46).
# =====================================================================

# ---- HTTPS ----------------------------------------------------------
RewriteEngine On
# проверку Let's Encrypt на https не уводим — она ходит по http
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# без www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ---- адреса без .html -----------------------------------------------
# Ссылки на сайте уже короткие. Здесь закрываем вторую половину: если
# кто-то придёт по старому адресу с .html (пересланная ссылка, закладка,
# выдача), уводим его на короткий одним 301 — чтобы одна и та же страница
# не жила по двум адресам.
#
# Условие смотрит на THE_REQUEST — исходную строку запроса. Внутренняя
# подстановка ниже её не меняет, поэтому петли не возникает.
#
# Знака «?» в конце подстановки быть не должно: он обрезает query-строку,
# и переход по ссылке из рекламы терял utm-метки (проверено: адрес
# /afisha.html?utm_source=yandex уезжал на /afisha без параметров).
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Файлы подтверждения прав (Вебмастер yandex_*.html, Search Console
# google*.html) роботы запрашивают по точному адресу с .html и ждут 200 —
# 301 на короткий адрес ломает проверку (открытие 28.08).
RewriteCond %{THE_REQUEST} !\s/+(yandex_[0-9a-f]+|google[0-9a-f]+)\.html[\s?] [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Слэш на конце убираем ДО подстановки .html. Без этой пары строк
# /afisha/ уходил в петлю внутренних перенаправлений и отдавал 500
# (в логе AH00124), потому что правило ниже пыталось открыть
# «afisha/.html» и запускало разбор заново.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/+$ /$1 [R=301,L]

# Страница сольника Гурама переехала с безличного /solnik на /guram
# (правка Анвера 19.08: в адресной строке стояло «solnik» вместо имени
# артиста). Старый адрес мог разойтись по ссылкам — держим 301.
RewriteRule ^solnik/?$ /guram [R=301,L]

# Раздел «Форматы» снят перед открытием сайта (решение 26.08): страница
# удалена, адрес уводим на главную, чтобы не остался пустой хвост.
RewriteRule ^formaty/?$ / [R=301,L]

# короткий адрес → реальный файл (внутренняя подстановка, без редиректа)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

DirectoryIndex index.html

# содержимое папок наружу не показываем
Options -Indexes

# ---- служебные файлы наружу не отдаём -------------------------------
# Скрипты выкладки на сервер не уезжают, но если файл попадёт туда
# руками — он всё равно останется закрытым.
<FilesMatch "^\.(htaccess|htpasswd|git|env|deploy-state)">
  Require all denied
</FilesMatch>

# json намеренно не в списке: сайту он сегодня не нужен, но если позже
# появится манифест или данные для виджета — правило молча их закроет.
<FilesMatch "\.(py|md|log|bak|sql)$">
  Require all denied
</FilesMatch>

# ---- кэш и сжатие ---------------------------------------------------
<IfModule mod_deflate.c>
  # text/javascript обязателен: Apache отдаёт .js именно с этим типом,
  # и без строки ниже скрипты уезжали несжатыми (75 КБ лишнего трафика).
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # афиша меняется часто — html не кэшируем
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType text/javascript           "access plus 7 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
</IfModule>

# Данные афиши правятся чаще, чем поднимается версия в ссылках, —
# держим их почти без кэша, чтобы снятое с продажи событие не висело
# у гостя в браузере неделю.
<FilesMatch "^events\.js$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  # always — иначе заголовки не доходят до ответов 401, 403 и 500
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # полгода: сайт живёт только на https, сертификат продлевается сам
  Header always set Strict-Transport-Security "max-age=15768000"
</IfModule>

ErrorDocument 404 /404.html
