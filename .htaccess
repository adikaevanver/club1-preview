# =====================================================================
# club1.moscow — конфигурация хостинга reg.ru (Apache)
#
# Пока сайт не показывают публично, он закрыт паролем. Чтобы открыть
# доступ всем, удалите блок «ЗАКРЫТЫЙ ДОСТУП» ниже — больше ничего
# менять не нужно.
# =====================================================================

# ---- ЗАКРЫТЫЙ ДОСТУП (удалить при публикации) -----------------------
# Путь к .htpasswd подставляет deploy.sh — руками править не нужно.
AuthType Basic
AuthName "Club1 — сайт в работе"
AuthUserFile /var/www/club1/data/www/club1.moscow/.htpasswd
Require valid-user

# пока сайт закрыт — держим его вне поисковой выдачи
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
# ---- конец блока ----------------------------------------------------

# ---- HTTPS ----------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# без www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ---- красивые адреса: /afisha вместо /afisha.html -------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

DirectoryIndex index.html

# ---- служебные файлы наружу не отдаём -------------------------------
<FilesMatch "^\.(htaccess|htpasswd|git)">
  Require all denied
</FilesMatch>

# ---- кэш и сжатие ---------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # афиша меняется часто — html не кэшируем
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /index.html
